# ============================================================
#  obsidian-epost-import — environment variables
#  Copy to .env and fill in. .env is NEVER committed.
# ============================================================

# ── Proton Mail Bridge (IMAP) ───────────────────────────────
# Bridge runs as its own service ("bridge") in this project's
# docker-compose.yml — see README "Step 3" for the one-time login
# (docker compose run --rm -it bridge init).
IMAP_HOST=bridge
# 143 = socat's forward port in the bridge container (see
# bridge/entrypoint.sh), NOT Bridge's own internal port (1143).
# Don't change this if you're running the bridge service.
IMAP_PORT=143
# Alternative: run Bridge natively (Windows/Mac/Linux) instead of
# in Docker, e.g. if you already have it running on another machine:
#   IMAP_HOST=host.docker.internal   (Bridge on the same machine as Docker)
#   IMAP_HOST=192.168.1.x            (Bridge on another machine on the LAN)
#   IMAP_PORT=1143                   (Bridge's normal default port natively)
# Then remove/scale down the bridge service in docker-compose.yml.
#
# The account's email address.
IMAP_USER=you@example.com
# Bridge-generated password (NOT your Proton password) — shown by
# the `info` command during the one-time login.
IMAP_PASS=change-to-the-bridge-password
# Bridge uses STARTTLS with a self-signed cert on localhost.
IMAP_SSL=false
IMAP_STARTTLS=true
IMAP_VERIFY_CERT=false

# Watched label/folder. Proton labels usually show up in Bridge as
# "Labels/Obsidian", folders as "Folders/Obsidian".
# Run `docker compose run --rm mail-importer list-folders`
# to see the exact names.
MAILBOX=Obsidian

# ── Obsidian Local REST API ─────────────────────────────────
# Get the key ONCE via the web UI, from the plugin's settings in
# the obsidian container (see README.md, Step 1).
OBSIDIAN_API_KEY=paste-the-local-rest-api-key-here
# These have sane defaults in docker-compose.yml — only set them
# if you want to deviate:
# OBSIDIAN_API_URL=https://obsidian:27124
# OBSIDIAN_API_VERIFY_TLS=false

# ── Where notes end up in the vault ─────────────────────────
NOTE_FOLDER=Email
ATTACHMENT_FOLDER=Email/attachments
# Comma-separated list of EXTRA static tags added on top of the
# real Proton labels discovered per email (the importer searches
# all Labels/* folders for the same Message-ID) — no longer the
# only source.
NOTE_LABELS=Obsidian

# ── Remote resources (images/documents linked from email bodies) ──
# Best-effort download of remote http(s) images and known document
# links (PDF/Word/Excel/...) so they survive if the sender's server
# later goes away. On any failure the original remote link is kept.
# REMOTE_FETCH_ENABLED=true
# REMOTE_FETCH_MAX_BYTES=26214400
# REMOTE_FETCH_TIMEOUT_SECONDS=20

# ── Runtime ──────────────────────────────────────────────────
# Safety-net poll when IMAP IDLE hasn't produced anything (seconds).
POLL_INTERVAL_SECONDS=300
# How long each IMAP IDLE wait may run (seconds). Also controls how
# quickly the container responds to SIGTERM.
IDLE_TIMEOUT_SECONDS=60
# Max backoff when reconnecting after a network error (seconds).
RECONNECT_BACKOFF_MAX_SECONDS=300
# Number of attempts (exponential backoff) against IMAP and the
# Local REST API.
API_MAX_RETRIES=3
LOG_LEVEL=INFO
# Docker HEALTHCHECK (and autoheal) consider mail-importer
# "unhealthy" if the heartbeat file hasn't updated in this long.
HEARTBEAT_MAX_AGE_SECONDS=900

# ── Shared ───────────────────────────────────────────────────
TZ=Europe/Stockholm

# ── obsidian container (LinuxServer.io image) ───────────────
# Pinned LSIO tag. Newer ones: https://github.com/linuxserver/docker-obsidian/releases
OBSIDIAN_BASE_TAG=v1.13.7-ls144
# Basic auth for the web UI — only used during the one-time setup.
# Change/rotate afterward.
OBSIDIAN_WEB_USER=admin
OBSIDIAN_WEB_PASSWORD=choose-a-temporary-password
# Vault name = directory under /config. The init script places the
# Local REST API plugin at /config/<this name>/.obsidian/...
OBSIDIAN_VAULT_NAME=Daniel
# Version of obsidian-local-rest-api the init script downloads.
# https://github.com/coddingtonbear/obsidian-local-rest-api/releases
LOCAL_REST_API_VERSION=5.1.0
# File owner inside the container (LSIO convention). Match your
# NAS host user if needed.
PUID=1000
PGID=1000

# ── bridge container (own image, see bridge/Dockerfile) ─────
# Pinned Proton Bridge version (matches the .deb release on GitHub).
# Newer ones: https://github.com/ProtonMail/proton-bridge/releases
BRIDGE_VERSION=3.26.0-1

# ── Resource limits (optional to change) ────────────────────
OBSIDIAN_MEM_LIMIT=1g
OBSIDIAN_CPUS=1.0
IMPORTER_MEM_LIMIT=512m
IMPORTER_CPUS=0.75
BRIDGE_MEM_LIMIT=512m
BRIDGE_CPUS=0.5
