# ============================================================
#  obsidian-epost-import — miljövariabler
#  Kopiera till .env och fyll i. .env committas ALDRIG.
# ============================================================

# ── Proton Mail Bridge (IMAP) ───────────────────────────────
# Bridge lyssnar på localhost på den maskin där den körs.
# Kör importern på samma maskin som Bridge:
#   IMAP_HOST=host.docker.internal
# Kör Bridge på en annan maskin i LAN:et:
#   IMAP_HOST=192.168.1.x
IMAP_HOST=host.docker.internal
# Porten hittar du i Proton Mail Bridge: Settings -> Advanced
# settings -> IMAP/SMTP. Standard är oftast 1143.
IMAP_PORT=1143
# Kontots e-postadress.
IMAP_USER=daniel@valfridsson.net
# Bridge-genererat lösenord (INTE ditt Proton-lösenord).
# Bridge: kontot -> "Mailbox details" / "Get Bridge password".
IMAP_PASS=byt-till-bridge-losenordet
# Bridge kör STARTTLS med självsignerat cert på localhost.
IMAP_SSL=false
IMAP_STARTTLS=true
IMAP_VERIFY_CERT=false

# Label/mapp som bevakas. Proton-labels dyker i Bridge oftast
# upp som "Labels/Obsidian", mappar som "Folders/Obsidian".
# Kör `docker compose run --rm mail-importer list-folders`
# för att se de exakta namnen.
MAILBOX=Obsidian

# ── Obsidian Local REST API ─────────────────────────────────
# Nyckeln hämtar du EN gång via webb-UI:t ur pluginets
# inställningar i obsidian-containern (se README.md, steg 1).
OBSIDIAN_API_KEY=klistra-in-local-rest-api-nyckeln
# Dessa har rimliga defaults i docker-compose.yml — sätt bara
# om du vill avvika:
# OBSIDIAN_API_URL=https://obsidian:27124
# OBSIDIAN_API_VERIFY_TLS=false

# ── Var noterna hamnar i valvet ─────────────────────────────
NOTE_FOLDER=Email
ATTACHMENT_FOLDER=Email/attachments
# Kommaseparerad lista, hamnar i frontmatterns "labels".
NOTE_LABELS=Obsidian

# ── Körning ─────────────────────────────────────────────────
# Säkerhetsnäts-poll när IMAP IDLE inte gett något (sekunder).
POLL_INTERVAL_SECONDS=300
# Hur länge varje IMAP IDLE-väntan får pågå (sekunder). Styr
# även hur snabbt containern svarar på SIGTERM.
IDLE_TIMEOUT_SECONDS=60
# Max backoff vid återanslutning efter nätverksfel (sekunder).
RECONNECT_BACKOFF_MAX_SECONDS=300
# Antal försök (exponential backoff) mot IMAP och Local REST API.
API_MAX_RETRIES=3
LOG_LEVEL=INFO

# ── Gemensamt ───────────────────────────────────────────────
TZ=Europe/Stockholm

# ── obsidian-containern (LinuxServer.io-image) ──────────────
# Pinnad LSIO-tagg. Nyare: https://github.com/linuxserver/docker-obsidian/releases
OBSIDIAN_BASE_TAG=v1.13.7-ls144
# Basic auth för webb-UI:t — används bara vid engångskonfig.
# Byt/rotera efteråt.
OBSIDIAN_WEB_USER=admin
OBSIDIAN_WEB_PASSWORD=valj-ett-tillfalligt-losenord
# Valvets namn = katalog under /config. Init-skriptet lägger
# Local REST API-pluginet i /config/<detta namn>/.obsidian/...
OBSIDIAN_VAULT_NAME=Daniel
# Version av obsidian-local-rest-api som init-skriptet hämtar.
# https://github.com/coddingtonbear/obsidian-local-rest-api/releases
LOCAL_REST_API_VERSION=5.1.0
# Fil-ägare inne i containern (LSIO-standard). Matcha din
# host-användare på NAS:en vid behov.
PUID=1000
PGID=1000

# ── Resursgränser (valfritt att ändra) ──────────────────────
OBSIDIAN_MEM_LIMIT=1g
OBSIDIAN_CPUS=1.0
IMPORTER_MEM_LIMIT=512m
IMPORTER_CPUS=0.75
