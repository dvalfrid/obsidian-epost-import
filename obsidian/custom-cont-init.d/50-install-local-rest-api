#!/usr/bin/with-contenv bash
# ------------------------------------------------------------------
#  Preinstalls / updates the obsidian-local-rest-api plugin in the
#  vault so mail-importer can reach the Local REST API on 27124.
#
#  - Idempotent: runs on every container start, does nothing if the
#    right version is already in place.
#  - NEVER fails the container: if the plugin can't be downloaded
#    (e.g. no internet at startup), a warning is logged and you'll
#    need to install it manually via the web UI instead.
#  - You still need to confirm Restricted mode / "Community plugins:
#    On" ONCE in the GUI (done at the same time as the LiveSync login
#    anyway).
# ------------------------------------------------------------------

PLUGIN_ID="obsidian-local-rest-api"
PLUGIN_VERSION="${LOCAL_REST_API_VERSION:-5.1.0}"
VAULT_NAME="${OBSIDIAN_VAULT_NAME:-Daniel}"

VAULT_DIR="/config/${VAULT_NAME}"
OBS_DIR="${VAULT_DIR}/.obsidian"
PLUGIN_DIR="${OBS_DIR}/plugins/${PLUGIN_ID}"
BASE_URL="https://github.com/coddingtonbear/${PLUGIN_ID}/releases/download/${PLUGIN_VERSION}"

log() { echo "[custom-init] local-rest-api: $*"; }

# --- Already the right version? -----------------------------------
if [ -f "${PLUGIN_DIR}/manifest.json" ] && \
   grep -q "\"version\"[[:space:]]*:[[:space:]]*\"${PLUGIN_VERSION}\"" "${PLUGIN_DIR}/manifest.json"; then
    log "v${PLUGIN_VERSION} already present in vault '${VAULT_NAME}' — skipping"
    exit 0
fi

log "installing v${PLUGIN_VERSION} into vault '${VAULT_NAME}'"
mkdir -p "${PLUGIN_DIR}"

# --- Fetch the plugin files --------------------------------------
required_ok=1
for f in manifest.json main.js styles.css; do
    if curl -fsSL --retry 3 --connect-timeout 10 -o "${PLUGIN_DIR}/${f}.tmp" "${BASE_URL}/${f}"; then
        mv "${PLUGIN_DIR}/${f}.tmp" "${PLUGIN_DIR}/${f}"
        log "fetched ${f}"
    else
        rm -f "${PLUGIN_DIR}/${f}.tmp"
        if [ "${f}" = "styles.css" ]; then
            log "no styles.css in this release (fine)"
        else
            log "WARNING: could not fetch ${f} — install the plugin manually via the GUI"
            required_ok=0
        fi
    fi
done

if [ "${required_ok}" != "1" ]; then
    exit 0
fi

# --- Enable the plugin -------------------------------------------
CP_FILE="${OBS_DIR}/community-plugins.json"
if [ ! -f "${CP_FILE}" ]; then
    printf '["%s"]\n' "${PLUGIN_ID}" > "${CP_FILE}"
    log "created community-plugins.json"
elif ! grep -q "\"${PLUGIN_ID}\"" "${CP_FILE}"; then
    # Insert the id first in the JSON array and clean up any
    # "[ ,\n" / ", ]" left over.
    sed -i "s/^\[[[:space:]]*/[\"${PLUGIN_ID}\", /" "${CP_FILE}"
    sed -i "s/,[[:space:]]*\]/]/" "${CP_FILE}"
    log "added ${PLUGIN_ID} to community-plugins.json"
fi

# --- Fix ownership so Obsidian (runs as 'abc') can read/write -----
# VAULT_DIR may have been created by the mkdir -p above as root on
# the very first run (if the vault didn't exist yet) — without
# chowning the vault root itself, only .obsidian, Obsidian can't
# open it ("no permission to access folder"). Not chowned
# recursively here: cheap, and LiveSync/Obsidian own everything
# they create themselves afterward. OBS_DIR is chowned recursively
# (just our plugin directory, small contents — and the early
# idempotency check above means this doesn't run on every boot once
# the plugin is already in place).
if command -v lsiown >/dev/null 2>&1; then
    lsiown abc:abc "${VAULT_DIR}"
    lsiown -R abc:abc "${OBS_DIR}"
else
    chown "${PUID:-1000}:${PGID:-1000}" "${VAULT_DIR}" 2>/dev/null || true
    chown -R "${PUID:-1000}:${PGID:-1000}" "${OBS_DIR}" 2>/dev/null || true
fi

log "done — confirm 'Community plugins: On' in the GUI during one-time setup"
exit 0
